rules_version = '2';

// Firestore в этом проекте больше не используется: чаты, сообщения и
// профили пользователей переехали на Redis (см. server.js,
// server/chatStore.js). Firebase здесь отвечает только за вход/регистрацию
// (Firebase Authentication), а Authentication не требует вообще никаких
// прав в Firestore. Поэтому базе Firestore нечего разрешать — закрываем всё.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
