rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- usernames/{username} ---
    // Документ ID = имя пользователя (в нижнем регистре). Служит и реестром
    // уникальных имён, и индексом для поиска пользователей.
    // update/delete запрещены — значит, "занять" имя можно только один раз:
    // если документ уже существует, попытка второй регистрации с тем же
    // именем автоматически считается "update" и будет отклонена.
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // --- users/{uid} ---
    // Профиль пользователя: username, avatarUrl, createdAt.
    // Читать профили могут все вошедшие (нужно, чтобы показывать имена и
    // аватарки собеседников в чате). Менять — только свой профиль.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // --- chats/{chatId} ---
    // Читать/обновлять (например, lastMessage) может только участник чата.
    // Создавать чат может только тот, кто сам входит в список участников.
    match /chats/{chatId} {
      allow read, update: if request.auth != null
                           && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.memberIds;
      allow delete: if false;

      // --- chats/{chatId}/messages/{messageId} ---
      match /messages/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
        allow create: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds
                      && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
